# Python
__pycache__/
*.pyc
.venv/
venv/

# ---------------------------------------------------------------------------
# CREDENTIALS & PERSONAL DATA — NEVER COMMIT
# ---------------------------------------------------------------------------
secrets/
*.key
*_key.txt
*_token.txt
.env
cookies.json

# Your real CV + cover-letter reference (supplied locally; see cv/README.txt)
cv/*.docx
cv/*.doc
cv/*.pdf
cv/cover_reference.txt

# The real applicant profile. Only the *.sample.json template is committed.
applicant_profile.json

# Built from the user's own CV by profileio.py and used to override the defaults
# in cvprofile.py. Holds CV-derived facts — roles, skills, years, education.
profile.json

# Your own runtime config. Only settings.sample.json is committed.
settings.json

# Multi-user web storage (config.DATA_DIR). Everything under it is per-deployment
# runtime state: data/app.db is the accounts DB — usernames and password hashes,
# plus live login tokens — and data/users/<id>/ holds each user's profile,
# tracker, output and BYO API keys. None of it belongs in version control.
# The -wal/-shm siblings are SQLite's write-ahead log and shared-memory files.
data/

# Claude Code / editor local state
.claude/
.vscode/
.idea/

# ---------------------------------------------------------------------------
# GENERATED OUTPUT — per-run workbooks, drafts, caches. All contain real
# scraped postings and, under applications/, your tailored CV + cover notes.
# ---------------------------------------------------------------------------
output/
master_tracker.xlsx
*.xlsx
*.docx
*.pdf
!cv/README.txt
